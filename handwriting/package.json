{
  "name": "gujarati-handwriting",
  "version": "1.3.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web --output-dir ../docs/handwriting && touch ../docs/handwriting/.nojekyll",
    "test": "jest",
    "extract-templates": "npx ts-node --transpile-only scripts/extract-templates.ts",
    "generate-model": "npx ts-node --transpile-only scripts/generate_model.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "expo": "~52.0.28",
    "expo-asset": "^57.0.17",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "svg-path-properties": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "private": true
}
